# ─────────────────────────────────────────────────
# NeuralOps environment variables
# Copy to .env.local and fill in values
# ─────────────────────────────────────────────────

# Optional: set this to load a REAL VS Code instance instead of the dummy panel.
# Must be a public GitHub repo (or you must be authenticated in the browser).
# Example: NEXT_PUBLIC_VSCODE_REPO=https://github.com/your-org/neuralops
NEXT_PUBLIC_VSCODE_REPO=

# Optional: your backend API base URL once it's deployed
# NEXT_PUBLIC_API_URL=http://localhost:8000
