<a class="text-slate-500 hover:text-blue-500 transition-colors opacity-80 hover:opacity-100 text-sm" href="#">Terms of Service</a>
<a class="text-slate-500 hover:text-blue-500 transition-colors opacity-80 hover:opacity-100 text-sm" href="#">Security</a>
<a class="text-slate-500 hover:text-blue-500 transition-colors opacity-80 hover:opacity-100 text-sm" href="#">Status</a>
</div>
</div>
</footer>
