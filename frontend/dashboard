<body class="bg-surface text-on-surface min-h-screen flex flex-col">
<!-- TopNavBar (Shared Component) -->
<header class="w-full sticky top-0 z-50 bg-white/60 dark:bg-slate-900/60 backdrop-blur-xl shadow-[0_20px_40px_rgba(0,98,157,0.08)]">
<nav class="flex justify-between items-center px-8 py-4 max-w-screen-2xl mx-auto font-['Plus_Jakarta_Sans'] font-medium">
<div class="flex items-center gap-8">
<a href="/" class="text-2xl font-bold tracking-tight bg-gradient-to-br from-blue-700 to-blue-400 bg-clip-text text-transparent">Breezy</a>
<div class="hidden md:flex items-center gap-6">
<a class="text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-300 transition-colors duration-300" href="/">Home</a>
<a class="text-blue-700 dark:text-blue-300 border-b-2 border-blue-500 pb-1" href="/dashboard">Dashboard</a>
</div>
</div>
<div class="flex items-center gap-4">
<a class="bg-primary text-on-primary px-6 py-2.5 rounded-full font-semibold scale-95 active:scale-90 transition-transform shadow-lg shadow-blue-500/20 inline-block text-center" href="/console">Try Demo</a>
<img alt="User Profile" class="w-10 h-10 rounded-full bg-surface-container shadow-sm" data-alt="close-up portrait of a professional smiling man in a modern office with soft daylight and bokeh background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBFs6lm8rskwy6qY7gtE67cAyLLKOembzm9Fqi6FvQRlkBKKD61SN3g78WcQCRzTwfvt_5DLl2LjN4BurkX4EC03ul3_rhQBftqBicbezWw-BcYRqTBYkfasNJpj6vyi0OwW7bN9MMKjSjcWL8g1Ol83CDz8v251g3rvEoZK6uKnfFYlIdd_EUtU7fsPu6ecM-JXtsHCuwOBI6g2z6d56uHTGUqL4DGoS3nXX0W39wX4zu8tZsWwyPBm5CqTuyogUwqm46jHj7qxWST"/>
</div>
</nav>
</header>
<main class="flex-grow max-w-screen-2xl mx-auto w-full px-8 py-12 space-y-12">
<!-- System Health Hero -->
<section class="relative overflow-hidden bg-gradient-to-br from-blue-700 to-blue-500 rounded-xl p-12 text-white shadow-2xl">
<div class="absolute top-0 right-0 w-1/3 h-full opacity-10">
<span class="material-symbols-outlined text-[240px] translate-x-20 translate-y-10" data-icon="cloud_done">cloud_done</span>
</div>
<div class="relative z-10 space-y-8">
<div class="space-y-2">
<span class="text-blue-100 font-label tracking-widest uppercase text-sm font-semibold">Live Ecosystem Status</span>
<h1 id="breezy-health-title" class="text-5xl font-extrabold tracking-tight">System Health: Optimal</h1>
<p id="breezy-health-sub" class="text-blue-50 text-lg max-w-2xl">All core automation nodes are humming. Breezy is currently managing 2,492 background tasks with 0% latency spikes.</p>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
<div class="bg-white/10 backdrop-blur-md rounded-lg p-6 border border-white/10 flex items-center gap-4">
<div class="w-12 h-12 rounded-full bg-emerald-400/20 flex items-center justify-center text-emerald-300">
<span class="material-symbols-outlined text-2xl" data-icon="radar" style="font-variation-settings: 'FILL' 1;">radar</span>
</div>
<div>
<div class="text-xl font-extrabold tracking-widest text-white">DETECT</div>
</div>
</div>
<div class="bg-white/10 backdrop-blur-md rounded-lg p-6 border border-white/10 flex items-center gap-4">
<div class="w-12 h-12 rounded-full bg-blue-300/20 flex items-center justify-center text-blue-100">
<span class="material-symbols-outlined text-2xl" data-icon="bug_report" style="font-variation-settings: 'FILL' 1;">bug_report</span>
</div>
<div>
<div class="text-xl font-extrabold tracking-widest text-white">DEBUG</div>
</div>
</div>
<div class="bg-white/10 backdrop-blur-md rounded-lg p-6 border border-white/10 flex items-center gap-4">
<div class="w-12 h-12 rounded-full bg-amber-300/20 flex items-center justify-center text-amber-100">
<span class="material-symbols-outlined text-2xl" data-icon="rocket_launch" style="font-variation-settings: 'FILL' 1;">rocket_launch</span>
</div>
<div>
<div class="text-xl font-extrabold tracking-widest text-white">DEPLOY</div>
</div>
</div>
</div>
</div>
</section>
<!-- Bento Grid: Live Issues & Nav Cards -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
<!-- Live Issues Card -->
<div class="lg:col-span-8 bg-surface-container-lowest rounded-xl p-8 shadow-[0_20px_40px_rgba(0,98,157,0.05)]">
<div class="flex justify-between items-center mb-8">
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-error" data-icon="error_med">error_med</span>
<h2 class="text-2xl font-bold">Live System Tickets</h2>
</div>
<span id="breezy-ticket-count" class="bg-error-container text-on-error-container px-4 py-1 rounded-full text-xs font-bold">0 Active</span>
</div>
<div class="space-y-3 max-h-[min(70vh,560px)] overflow-y-auto pr-1 -mr-1" id="breezy-live-tickets">
</div>
</div>
<!-- Navigation Cards -->
<div class="lg:col-span-4 space-y-8">
<!-- Config Monitor -->
<a class="block bg-secondary-container text-on-secondary-container p-8 rounded-xl shadow-lg hover:translate-y-[-4px] transition-transform group overflow-hidden relative" href="/config-monitor">
<div class="absolute -right-4 -bottom-4 opacity-10">
<span class="material-symbols-outlined text-9xl" data-icon="settings_ethernet">settings_ethernet</span>
</div>
<div class="relative z-10 space-y-4">
<div class="w-12 h-12 rounded-lg bg-white/40 flex items-center justify-center">
<span class="material-symbols-outlined" data-icon="terminal">terminal</span>
</div>
<div>
<h3 class="text-xl font-bold">Config Monitor</h3>
<p class="text-sm opacity-80 mt-1">Direct access to demo/config.json and environment vars.</p>
</div>
<div class="flex items-center gap-2 text-xs font-bold group-hover:gap-4 transition-all">
                            EXPLORE CONFIG <span class="material-symbols-outlined text-sm" data-icon="arrow_forward">arrow_forward</span>
</div>
</div>
</a>
<!-- Code Monitor -->
<a class="block bg-primary-fixed text-on-primary-fixed p-8 rounded-xl shadow-lg hover:translate-y-[-4px] transition-transform group overflow-hidden relative" href="/code-monitor">
<div class="absolute -right-4 -bottom-4 opacity-10">
<span class="material-symbols-outlined text-9xl" data-icon="pipeline">plumbing</span>
</div>
<div class="relative z-10 space-y-4">
<div class="w-12 h-12 rounded-lg bg-white/40 flex items-center justify-center text-primary">
<span class="material-symbols-outlined" data-icon="confirmation_number">confirmation_number</span>
</div>
<div>
<h3 class="text-xl font-bold">Code Monitor</h3>
<p class="text-sm opacity-80 mt-1">Open the Code Defect Lab to inspect demo code and defect flows.</p>
</div>
<div class="flex items-center gap-2 text-xs font-bold group-hover:gap-4 transition-all">
                            OPEN CODE MONITOR <span class="material-symbols-outlined text-sm" data-icon="arrow_forward">arrow_forward</span>
</div>
</div>
</a>
</div>
</div>
