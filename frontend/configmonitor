<main class="flex-grow p-8 max-w-screen-2xl mx-auto w-full space-y-8">
<!-- System Health Header Section -->
<section class="grid grid-cols-1 md:grid-cols-3 gap-6">
<div class="md:col-span-2 flex flex-col justify-center">
<h1 class="text-4xl font-headline font-extrabold tracking-tight text-on-surface mb-2">Config Monitor</h1>
<p class="text-on-surface-variant text-lg">Manage your orchestration logic and monitor agent behavior in real-time.</p>
</div>
<div class="bg-surface-container-lowest p-6 rounded-xl shadow-[0_20px_40px_rgba(0,98,157,0.06)] flex items-center justify-between border border-white/50">
<div>
<div class="flex items-center gap-2 mb-1">
<span id="breezy-status-dot" class="w-3 h-3 bg-tertiary rounded-full animate-pulse"></span>
<span class="text-sm font-medium text-on-surface-variant">Current Status</span>
</div>
<div id="breezy-config-status-title" class="text-xl font-headline font-bold text-on-surface">Resolving Issues...</div>
<div id="breezy-config-status-sub" class="text-sm text-blue-600 font-medium">Connecting to agents…</div>
</div>
<div class="bg-blue-50 p-3 rounded-full">
<span class="material-symbols-outlined text-blue-600" style="font-size: 32px;">memory</span>
</div>
</div>
</section>
<!-- Main Layout: Three Columns (Sidebar + Code + Activity) -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
<!-- Left Column: Bug Injection Sidebar -->
<div class="lg:col-span-3 space-y-4">
<div class="flex items-center gap-2 px-2 mb-2">
<span class="material-symbols-outlined text-error text-xl">pest_control</span>
<h2 class="font-headline font-bold text-xl text-on-surface">Bug Injection</h2>
</div>
<div class="flex flex-col gap-3">
<button type="button" data-breezy-fault="lock_user" class="bug-btn group flex items-start gap-4 p-4 bg-white hover:bg-red-50 border border-slate-100 hover:border-red-200 rounded-xl transition-all shadow-sm active:scale-[0.98]">
<span class="material-symbols-outlined bug-icon text-red-500 mt-0.5 transition-transform">lock</span>
<div class="text-left">
<div class="font-bold text-sm text-slate-800">Locked User Account</div>
<p class="text-xs text-slate-500 mt-1">Simulate massive 403 spikes from auth-service.</p>
</div>
</button>
<button type="button" data-breezy-fault="zero_pool" class="bug-btn group flex items-start gap-4 p-4 bg-white hover:bg-amber-50 border border-slate-100 hover:border-amber-200 rounded-xl transition-all shadow-sm active:scale-[0.98]">
<span class="material-symbols-outlined bug-icon text-amber-600 mt-0.5 transition-transform">database</span>
<div class="text-left">
<div class="font-bold text-sm text-slate-800">DB Connection Warning</div>
<p class="text-xs text-slate-500 mt-1">Simulate connection pool exhaustion in Postgres.</p>
</div>
</button>
<button type="button" data-breezy-fault="zero_rate_limit" class="bug-btn group flex items-start gap-4 p-4 bg-white hover:bg-purple-50 border border-slate-100 hover:border-purple-200 rounded-xl transition-all shadow-sm active:scale-[0.98]">
<span class="material-symbols-outlined bug-icon text-purple-600 mt-0.5 transition-transform">bolt</span>
<div class="text-left">
<div class="font-bold text-sm text-slate-800">Latency Spike</div>
<p class="text-xs text-slate-500 mt-1">Inject 2000ms delay into US-East gateway.</p>
</div>
</button>
<button type="button" data-breezy-fault="crash_services" class="bug-btn group flex items-start gap-4 p-4 bg-white hover:bg-slate-50 border border-slate-100 hover:border-slate-200 rounded-xl transition-all shadow-sm active:scale-[0.98]">
<span class="material-symbols-outlined bug-icon text-slate-600 mt-0.5 transition-transform">refresh</span>
<div class="text-left">
<div class="font-bold text-sm text-slate-800">OOM Loop</div>
<p class="text-xs text-slate-500 mt-1">Trigger restart-on-failure loop for micro-services.</p>
</div>
</button>
</div>
<div class="p-4 bg-surface-container-low rounded-xl border border-outline-variant/30 mt-4">
<p class="text-[10px] uppercase font-bold text-slate-400 tracking-widest mb-2">Instructions</p>
<p class="text-xs text-on-surface-variant leading-relaxed">Selecting a bug will trigger real-time SSE event simulation for connected agents.</p>
</div>
