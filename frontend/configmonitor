<span class="px-3 py-1 bg-primary-fixed text-on-primary-fixed text-[10px] font-bold rounded-full uppercase tracking-widest flex items-center gap-1.5">
<span class="w-1.5 h-1.5 bg-current rounded-full animate-pulse"></span>
